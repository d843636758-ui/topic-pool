# ---------- Required-ish ----------
# Persist this directory with a Zeabur Volume.
DATA_DIR=/data/topic-pool

# Zeabur supplies PORT automatically; normally do not set it yourself.
# PORT=8000


# ---------- Scout schedule ----------
SCOUT_INTERVAL_MINUTES=360
SCOUT_ON_STARTUP=true
SCOUT_STARTUP_DELAY_SECONDS=20

TOPIC_TTL_HOURS=36
MAX_TOPICS_PER_RUN=3
CANDIDATES_PER_SOURCE=8

SCOUT_CATEGORIES_PER_RUN=3

SCOUT_SOURCES=google_news,hacker_news,arxiv,github
SCOUT_CATEGORIES=ai,technology,science,law,world,culture,weird


# ---------- Google News RSS ----------
GOOGLE_NEWS_LANG=zh-CN
GOOGLE_NEWS_COUNTRY=CN
GOOGLE_NEWS_EDITION=CN:zh-Hans


# ---------- Optional GitHub API ----------
# Recommended if you want GitHub Scout.
# Unauthenticated search is rate-limited.
#
# GITHUB_TOKEN=github_pat_xxx


# ---------- Optional LLM filter ----------
# Without an API key, the server falls back
# to a deterministic heuristic filter.
#
# Recommended if you already have a DeepSeek key:
#
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# FILTER_MODEL=deepseek-v4-flash
# LLM_FILTER_ENABLED=true
#
# Generic OpenAI-compatible alternative:
#
# LLM_PROVIDER=generic
# LLM_API_KEY=...
# LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
# FILTER_MODEL=your-model-name
# LLM_FILTER_ENABLED=true
#
# OPENAI_API_KEY is also still accepted
# as a compatibility shortcut.

LLM_FILTER_ENABLED=false


# ---------- MCP access ----------
# Optional shared secret.
#
# If set, client must send either:
#
# Authorization: Bearer <token>
#
# or:
#
# X-Topic-Pool-Key: <token>
#
# MCP_AUTH_TOKEN=replace-with-a-long-random-secret


# Zeabur is a reverse proxy,
# so this defaults true in config.py.
MCP_DISABLE_DNS_REBINDING_PROTECTION=true


# Alternative stricter host allowlist:
#
# MCP_DISABLE_DNS_REBINDING_PROTECTION=false
# MCP_ALLOWED_HOSTS=your-service.zeabur.app,your-service.zeabur.app:*
# MCP_ALLOWED_ORIGINS=https://chatgpt.com


# Optional per-client header,
# configured on the client side rather than server side:
#
# X-Topic-Consumer: chatgpt
# X-Topic-Consumer: io


LOG_LEVEL=INFO
